# Retrieval search provider. Choose either `tavily` or `serper` when ready to
# run web search; leave both values blank for direct-hint-only retrieval.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Future structured-extraction and Composio-catalog credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
COMPOSIO_API_KEY=

MAX_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=30
